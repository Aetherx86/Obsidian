# Iterative Fibonacci with 64-bit wrapping arithmetic.
fn fib(n) {
    a = 0
    b = 1
    i = 0
    unused = mul n, 1000        # dead: removed by the optimizer
    k = mul 6, 7                # folded to a constant
loop:
    br ge i, n, done
    t = add a, b
    a = b
    b = t
    i = add i, 1
    jmp loop
done:
    ret a
}
